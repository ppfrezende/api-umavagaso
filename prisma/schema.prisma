generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MENTOR
  STUDENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum PhaseStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  description String?
  logo        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User   @relation("TenantOwner", fields: [ownerId], references: [id])
  ownerId String @unique

  userTenants    UserTenant[]
  invitations    Invitation[]
  phaseTemplates PhaseTemplate[]

  @@map("tenants")
}

model User {
  id                      String    @id @default(uuid())
  name                    String
  email                   String    @unique
  emailVerified           DateTime?
  emailVerificationToken  String?
  emailVerificationExpiry DateTime?
  password_hash           String
  avatar                  String?
  role                    Role      @default(STUDENT)
  isActive                Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  ownedTenants    Tenant[]       @relation("TenantOwner")
  userTenants     UserTenant[]
  invitationsSent Invitation[]   @relation("InvitationsSent")
  studentPhases   StudentPhase[]

  @@map("users")
}

model UserTenant {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  role      Role
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@map("user_tenants")
}

model Invitation {
  id             String           @id @default(uuid())
  email          String
  tenantId       String
  role           Role             @default(STUDENT)
  token          String           @unique
  expiresAt      DateTime
  invitedBy      String
  status         InvitationStatus @default(PENDING)
  isExistingUser Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inviter User   @relation("InvitationsSent", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([tenantId])
  @@index([token])
  @@index([status])
  @@map("invitations")
}

model PhaseTemplate {
  id                        String   @id @default(uuid())
  tenantId                  String
  name                      String
  description               String?
  purpose                   String
  defaultOrder              Int
  isActive                  Boolean  @default(true)
  suggestedDurationDays     Int?
  defaultMinAccuracy        Decimal? @db.Decimal(5, 2)
  defaultMinCompletion      Decimal? @db.Decimal(5, 2)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentPhases StudentPhase[]

  @@unique([tenantId, defaultOrder])
  @@index([tenantId])
  @@index([isActive])
  @@map("phase_templates")
}

model StudentPhase {
  id                     String       @id @default(uuid())
  studentId              String
  editalId               String?
  phaseTemplateId        String?
  name                   String
  description            String?
  purpose                String?
  order                  Int
  status                 PhaseStatus  @default(NOT_STARTED)
  startedAt              DateTime?
  completedAt            DateTime?
  currentAccuracy        Decimal?     @db.Decimal(5, 2)
  currentCompletion      Decimal?     @db.Decimal(5, 2)
  minAccuracyToAdvance   Decimal?     @db.Decimal(5, 2)
  minCompletionToAdvance Decimal?     @db.Decimal(5, 2)
  suggestedDurationDays  Int?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  student       User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  phaseTemplate PhaseTemplate? @relation(fields: [phaseTemplateId], references: [id], onDelete: SetNull)

  @@unique([studentId, editalId, order])
  @@index([studentId])
  @@index([editalId])
  @@index([status])
  @@index([phaseTemplateId])
  @@map("student_phases")
}
