generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String  @id @default(uuid())
  name        String
  description String?
  logo        String?

  users User[]

  @@map("tenants")
}

enum Role {
  MENTOR
  STUDENT
}

model User {
  id     String  @id @default(uuid())
  name   String
  email  String
  role   Role    @default(STUDENT)
  avatar String?

  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  tenantId String?

  @@map("users")
}
